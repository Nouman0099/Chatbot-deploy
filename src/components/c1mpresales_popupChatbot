<script>
window.addEventListener("DOMContentLoaded", function () {
  const script = document.createElement("script");
  script.src = "https://cai.c1m.ai/embed.js";
  script.onload = function () {
    if (window.Chatbot) {
      window.Chatbot.init({
        apiUrl: "https://cai.c1m.ai/popup/Chat-C1M-Presales",
        welcomeMessage: "Hey there! How can I help you today?",
        position: "right",
        sidePadding: "20px",
        bottom: "0px",
        width: "700px",
        height: "600px",
        fontSize: "24px",
        fontColor: "#ffffff", // body font color
        bgColor: "#4338ca", // header background Gradient here 
        bgColor1: "#35225d", // body background
        bubbleColor: "#6b21a8", // user message bg color
        userMessageFontColor: "#ffffff", // user message font color
        botColor: "#6b21a8", // chatbot response bg color
        chatbotResponseFontColor: "#ffffff", // chatbot response font color
        inputBgColor: "#4f46e5", // input field background color
        inputTextColor: "#ffffff", // input field text color
        inputBorderColor: "#4f46e5", // input field border color
        inputPlaceHolderColor: "#ffffff", // input placeholder color
        submitTextColor: "#ffffff", // submit button text color
        submitBgColor: "#4338ca", // submit button background color
        messageBorderColor: "#C084FC", // message border color
        bgColorFooter: "#4338ca", // bg footer color
        bgColorPoweredByIcon: "purple", //  bgColorPoweredByIcon
        fontColorDate: "#ffffff", // date color
        fontColorHeader: "black", // header font color
        fontColorPoweredBy: "#ffffff", // font color PoweredBy
        bgColorMessage: "purple", // bg color of greeting message
        fontColorMessage: "#ffffff", // font color of greeting message
        loaderColor: "purple", // loader color
      });
    }
  };
  document.head.appendChild(script);
});
</script>