 <script>
      window.addEventListener("DOMContentLoaded", function () {
        const script = document.createElement("script");
        script.src = "https://cai.c1m.ai/embed.js";
        script.onload = function () {
          if (window.Chatbot) {
            window.Chatbot.init({
              apiUrl: "https://cai.c1m.ai/financeforfounder",
              position: "right",
              sidePadding: "30px",
              bottom: "0px",
              width: "700px",
              height: "600px",
              fontSize: "24px",
              welcomeMessage: "Hello , thank you for contacting FinanceForFounder!",
              fontColor: "#ffffff",
              bgColor: "#343541", // Gradient here
              bubbleColor: "#40414F", // user message bg color
              userMessageFontColor: "#ECECF1", // user message font color
              botColor: "#40414F", // chatbot response bg color
              chatbotResponseFontColor: "#ECECF1", // chatbot response font color
              inputBgColor: "#40414F", // input field background color
              inputTextColor: "#ECECF1", // input field text color
              inputBorderColor: "#565869", // input field border color
              inputPlaceHolderColor: "#9CA3AF", // input placeholder color
              submitTextColor: "#202123", // submit button text color
              submitBgColor: "#ffffff", // submit button background color
              messageBorderColor: "#6B7280", // message border color
              loaderColor: "#ffffff", // loader color
              bgColorPoweredByIcon: "#202123", //  bgColorPoweredByIcon
              fontColorDate: "#ffffff", // date color
              bgColorMessage: "#40414F", // bg color of greeting message
              fontColorMessage: "#ffffff", // font color of greeting message
              fontColorPoweredBy: "#ffffff", // font color PoweredBy
            });
          }
        };
        document.head.appendChild(script);
      });
    </script>